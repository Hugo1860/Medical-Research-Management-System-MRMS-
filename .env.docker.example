POSTGRES_DB=ScientificResearch_Model
POSTGRES_USER=postgres
POSTGRES_PASSWORD=请替换为强密码
POSTGRES_HOST_PORT=15433
APP_HOST_PORT=16379
APP_PLATFORM=linux/amd64
POSTGRES_EXPECTED_SCHEMA_VERSION=109
ETHICS_ARCHIVE_PROVIDER=Local
ETHICS_ARCHIVE_LOCAL_ROOT=wwwroot
ETHICS_ARCHIVE_REQUIRE_EXISTING_OBJECT=true
ETHICS_ARCHIVE_MAX_FILE_BYTES=10485760
SWAGGER_ENABLED=false
AUDIT_TIMEOUT_SECONDS=3
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=3
TRUSTED_PROXY_0=127.0.0.1
TRUSTED_PROXY_1=::1
REDIS_CONFIGURATION=
REDIS_INSTANCE_NAME=ScientificResearch:
# 已实现的代理授权范围白名单。
PROXY_SCOPE_0=项目审批

# ExternalSync 默认关闭。只有八类适配器均完成真实地址、字段协议、
# 凭据注入和回执验收后才允许改为 true；不要把 token 写入此模板。
EXTERNAL_SYNC_ENABLED=false
EXTERNAL_SYNC_POLL_INTERVAL_SECONDS=30
EXTERNAL_SYNC_BATCH_SIZE=10
EXTERNAL_SYNC_REQUEST_TIMEOUT_SECONDS=30
EXTERNAL_SYNC_LEASE_TIMEOUT_SECONDS=900
FINANCE_INVOICE_OCR_ENABLED=false
# 与外部系统登记中的“认证引用”一致；值只在受控部署环境注入。
# HIS_HR_TOKEN=
# FINANCE_API_TOKEN=
# PROCUREMENT_API_TOKEN=
# Optional Redis overlay: set a strong password before using docker-compose.redis.yml.
# REDIS_PASSWORD=请替换为强密码

# Keycloak 统一身份（切换前先创建 realm/client，并确保 username=人员.工号）
KEYCLOAK_ENABLED=false
KEYCLOAK_AUTHORITY=https://sso.example.org/realms/scientific-research
KEYCLOAK_AUDIENCE=scientificresearch-api
KEYCLOAK_CLIENT_ID=scientificresearch-api
# Browser callback; leave empty to use the current login page URL.
KEYCLOAK_REDIRECT_URI=
KEYCLOAK_REQUIRE_HTTPS_METADATA=true
KEYCLOAK_USER_IDENTIFIER_CLAIM=preferred_username
KEYCLOAK_DB_KEY=ScientificResearch_Model

# 运行时预检默认要求统一认证可用。只有明确进入密码应急模式时才设置：
# REQUIRE_KEYCLOAK=false
# CHECK_KEYCLOAK_DISCOVERY=false

# 验收脚本可选：仅在目标环境临时注入，不要写入仓库或长期保存。
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_USERNAME=测试账号
# KEYCLOAK_PASSWORD=测试密码
# KEYCLOAK_ACCESS_TOKEN=

# Excel 功能启用时填写合法 EPPlus 授权配置；不使用 Excel 可暂留空。
EPPlusLicenseContext=

# 正式电子签章/电子档案默认关闭；未完成供应商协议、HTTPS 端点和适配器验收前不要启用。
ELECTRONIC_SIGNATURE_ENABLED=false
ELECTRONIC_SIGNATURE_PROVIDER=
ELECTRONIC_SIGNATURE_ENDPOINT=
ELECTRONIC_SIGNATURE_PROTOCOL_VERSION=
ELECTRONIC_SIGNATURE_ADAPTER_READY=false
ELECTRONIC_SIGNATURE_REQUIRE_HTTPS=true
ELECTRONIC_ARCHIVE_ENABLED=false
ELECTRONIC_ARCHIVE_PROVIDER=
ELECTRONIC_ARCHIVE_ENDPOINT=
ELECTRONIC_ARCHIVE_PROTOCOL_VERSION=
ELECTRONIC_ARCHIVE_ADAPTER_READY=false
ELECTRONIC_ARCHIVE_REQUIRE_HTTPS=true

# 外部专家邀请默认只登记“未配置”队列，不发送邮件或身份服务请求。
EXTERNAL_EXPERT_INVITATION_ENABLED=false
EXTERNAL_EXPERT_INVITATION_ADAPTER_READY=false
EXTERNAL_EXPERT_INVITATION_PROVIDER=
EXTERNAL_EXPERT_INVITATION_ENDPOINT=
EXTERNAL_EXPERT_INVITATION_REQUIRE_HTTPS=true
