# Copy to /etc/scientificresearch/scientificresearch.env and chmod 600.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:63739

# Replace the placeholders with the production secret. Keep this file out of source control.
connectionString__ScientificResearch_Release=Host=db.example.org;Port=5432;Database={0};Username=科研系统账号;Password=请填入密钥;SSL Mode=Require;Trust Server Certificate=False
allowedDatabaseKeys__0=ScientificResearch_Model
Postgres__ExpectedSchemaVersion=106
Storage__Provider=Minio
Storage__Minio__Endpoint=minio:9000
Storage__Minio__ExternalEndpoint=http://127.0.0.1:19000
Storage__Minio__BucketName=scientificresearch-private
EthicsArchive__Provider=Local
EthicsArchive__LocalRoot=wwwroot
EthicsArchive__RequireExistingObject=true
EthicsArchive__MaxFileBytes=10485760
Swagger__Enabled=false
Audit__TimeoutSeconds=3
# 正式电子签章/电子档案默认关闭。内部确认和本地上传不构成法律电子签章或正式电子档案托管。
# 只有供应商合同、协议版本、HTTPS 端点和真实适配器联调验收全部完成后才可启用。
ElectronicSignature__Enabled=false
ElectronicSignature__Provider=
ElectronicSignature__Endpoint=
ElectronicSignature__ProtocolVersion=
ElectronicSignature__AdapterReady=false
ElectronicSignature__RequireHttps=true
ElectronicArchive__Enabled=false
ElectronicArchive__Provider=
ElectronicArchive__Endpoint=
ElectronicArchive__ProtocolVersion=
ElectronicArchive__AdapterReady=false
ElectronicArchive__RequireHttps=true
# Keep the worker disabled until all eight supplier contracts are accepted.
# This lease recovers tasks left in 处理中 after a worker crash.
ExternalSync__LeaseTimeoutSeconds=900
ForwardedHeaders__TrustedProxies__0=127.0.0.1
ForwardedHeaders__TrustedProxies__1=::1
Redis__Configuration=
Redis__InstanceName=ScientificResearch:
# 仅开放已实现且经过审批的代理范围；多个范围用数组环境变量继续编号。
权限代理范围__0=项目审批

# 外部同步 worker 默认关闭。配置 HR/财务适配器后仍需完成八类系统验收，
# 再由受控变更将 ExternalSync__Enabled 改为 true。
ExternalSync__Enabled=false
ExternalSync__PollIntervalSeconds=30
ExternalSync__BatchSize=10
ExternalSync__RequestTimeoutSeconds=30
ExternalSync__LeaseTimeoutSeconds=900
Finance__InvoiceOcr__Enabled=false
# 认证引用对应密钥管理系统中的变量名；此模板不填入密钥值。
# ExternalSystems__Secrets__HIS_HR_TOKEN=
# ExternalSystems__Secrets__FINANCE_API_TOKEN=
# ExternalSystems__Secrets__PROCUREMENT_API_TOKEN=

# Keycloak 统一身份。启用前先创建 realm/client，并让 Keycloak username 与人员.工号一致。
Keycloak__Enabled=false
Keycloak__Authority=https://sso.example.org/realms/scientific-research
Keycloak__Audience=scientificresearch-api
Keycloak__ClientId=scientificresearch-api
Keycloak__RedirectUri=https://research.example.org/IMIS/views/login.html
Keycloak__RequireHttpsMetadata=true
# When enabled, the application rejects valid tokens without an accepted MFA amr.
# KEYCLOAK_REQUIRE_MFA=true
# KEYCLOAK_MFA_AMR=otp,mfa
Keycloak__UserIdentifierClaim=preferred_username
Keycloak__DbKey=ScientificResearch_Model
# check-runtime.sh 默认要求 OIDC 公共配置 enabled=true；密码应急模式必须显式设置：
# REQUIRE_KEYCLOAK=false
# CHECK_KEYCLOAK_DISCOVERY=false

# EPPlus 8 requires a valid license configuration. Do not commit the key.
EPPlusLicenseContext=Commercial:请填入EPPlus授权密钥

# 外部专家邀请默认关闭；未配置真实邮件/身份适配器时只登记“未配置”队列，不发送。
ExternalExpertInvitation__Enabled=false
ExternalExpertInvitation__AdapterReady=false
ExternalExpertInvitation__Provider=
ExternalExpertInvitation__Endpoint=
ExternalExpertInvitation__RequireHttps=true
